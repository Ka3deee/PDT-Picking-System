<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PDTPickingSystem.Views.CheckingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <!-- ROOT LAYER -->
    <Grid>
        <!-- LAYER 1: Main Content (Scrollable) -->
        <ScrollView VerticalOptions="FillAndExpand">
            <VerticalStackLayout Padding="5" Spacing="5">

                <!-- Store / Department - AT THE TOP -->
                <Grid ColumnDefinitions="120,*"
                      Margin="10,0,5,10"
                      VerticalOptions="Center">
                    <Label x:Name="lblDeptStore"
                           Text="Store No:"
                           FontAttributes="Bold"
                           FontSize="16"
                           Grid.Column="0"
                           VerticalOptions="Center"
                           Loaded="LblDeptStore_Loaded"
                           Margin="0,-5,10,0"/>
                    <Frame Grid.Column="1"
                           Padding="-5"
                           CornerRadius="5"
                           HasShadow="True"
                           BorderColor="Gray"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           Margin="0,0,0,5">
                        <Entry x:Name="txtDeptStore"
                           Grid.Column="1"
                           BackgroundColor="WhiteSmoke"
                           IsReadOnly="True"
                           HorizontalTextAlignment="Center"
                           TextChanged="TxtDeptStore_TextChanged"/>
                    </Frame>
                </Grid>

                <!-- Main Input Frame -->
                <Frame Padding="10,10,10,10"
                        Margin="5,-15,5,0"
                        HasShadow="True"
                       CornerRadius="10"
                        BorderColor="LightGray">
                    <VerticalStackLayout x:Name="pnlInput"
                                         Spacing="5">

                        <!-- Barcode -->
                        <Label x:Name="lblBarcode"
                               Text="Barcode:"
                               FontAttributes="Bold"
                               FontSize="16"
                               Loaded="LblBarcode_Loaded"/>
                        <Frame Grid.Column="1"
                               Padding="0"
                               CornerRadius="5"
                               HasShadow="True"
                               BorderColor="Gray"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               Margin="0,-5,0,5">
                            <Entry x:Name="txtBarcode"
                               Placeholder="Barcode"
                               FontSize="16"
                               Completed="Entry_Completed"
                               HorizontalTextAlignment="Center"
                               TextChanged="Entry_TextChanged"/>
                        </Frame>

                        <!-- Description -->
                        <Frame Grid.Column="1"
                               Padding="-5"
                               CornerRadius="5"
                               HasShadow="True"
                               BorderColor="Gray"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               Margin="0,0,0,5">
                            <Entry x:Name="txtDesc"
                               Placeholder="Description"
                               FontSize="16"
                               HeightRequest="45"
                               IsReadOnly="True"
                               HorizontalTextAlignment="Center"
                               TextChanged="TxtDesc_TextChanged"/>
                        </Frame>

                        <!-- Scanner + SKU -->
                        <Grid ColumnDefinitions="50,10,Auto,*"
                              Margin="0,0,0,10">
                            <ContentView Grid.Column="0" 
                                         WidthRequest="50"
                                         HeightRequest="40">
                                <ImageButton x:Name="pbScanned"
                                             Grid.Column="0"
                                             Source="scanned_icon2.png"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             BackgroundColor="White"
                                             IsVisible="False"/>
                            </ContentView>
                            <Label x:Name="lblSKU"
                                   Grid.Column="2"
                                   Text="SKU:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   Loaded="LblSKU_Loaded"/>
                            <Frame Grid.Column="3"
                                   Padding="-5"
                                   CornerRadius="5"
                                   HasShadow="True"
                                   BorderColor="Gray"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   Margin="5,0,0,0">
                                <Entry x:Name="txtSKU"
                                           Grid.Column="3"
                                           Placeholder=""
									       FontSize="16"
                                           IsReadOnly="True"
                                           HeightRequest="45"
                                           HorizontalTextAlignment="Center"
                                           TextChanged="TxtSKU_TextChanged"/>
                            </Frame>
                        </Grid>

                        <!-- Case / Each -->
                        <Grid ColumnDefinitions="Auto,*,20,Auto,*"
                              Margin="0,-5,0,10">
                            <Label x:Name="lblCase"
                                   Text="Case:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   Grid.Column="0" 
                                   VerticalOptions="Center" 
                                   Loaded="LblCase_Loaded"/>
                            <Frame Grid.Column="1"
                                   Padding="-5"
                                   CornerRadius="5"
                                   HasShadow="True"
                                   BorderColor="Gray"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   Margin="5,0,0,0">
                                <Entry x:Name="txtCase" 
                                       Grid.Column="1" 
                                       HeightRequest="45"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       Completed="Entry_Completed" 
                                       HorizontalTextAlignment="Center"
                                       TextChanged="Entry_TextChanged"/>
                            </Frame>
                            <BoxView Grid.Column="2" 
                                     WidthRequest="20"/>
                            <Label x:Name="lblEach" 
                                   Text="Each:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   Grid.Column="3" 
                                   VerticalOptions="Center" 
                                   Loaded="LblEach_Loaded"/>
                            <Frame Grid.Column="4"
                                   Padding="-5"
                                   CornerRadius="5"
                                   HasShadow="True"
                                   BorderColor="Gray"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   Margin="5,0,0,0">
                                <Entry x:Name="txtEach"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       Grid.Column="4"
                                       HeightRequest="45" 
                                       Completed="Entry_Completed" 
                                       HorizontalTextAlignment="Center"
                                       TextChanged="Entry_TextChanged"/>
                            </Frame>
                        </Grid>

                        <!-- BUM / Done -->
                        <Grid ColumnDefinitions="Auto,*,20,Auto,*" 
                              Margin="0,-5,0,10">
                            <Label x:Name="lblBUM" 
                                   Text="BUM:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   Grid.Column="0" 
                                   VerticalOptions="Center" 
                                   Loaded="LblBUM_Loaded"/>
                            <Frame Grid.Column="1"
                                   Padding="-5"
                                   CornerRadius="5"
                                   HasShadow="True"
                                   BorderColor="Gray"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   Margin="5,0,0,0">
                                <Entry x:Name="txtBum"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       Grid.Column="1" 
                                       HeightRequest="45" 
                                       IsReadOnly="True"
                                       HorizontalTextAlignment="Center"
                                       TextChanged="TxtBum_TextChanged"/>
                            </Frame>
                            <BoxView Grid.Column="2" 
                                     WidthRequest="20"/>
                            <Label x:Name="lblDone" 
                                   Text="Done:"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   Grid.Column="3" 
                                   VerticalOptions="Center" 
                                   Loaded="LblDone_Loaded"/>
                            <Frame Grid.Column="4"
                                   Padding="-5"
                                   CornerRadius="5"
                                   HasShadow="True"
                                   BorderColor="Gray"
                                   VerticalOptions="Center"
                                   HorizontalOptions="FillAndExpand"
                                   Margin="5,0,0,0">
                                <Entry x:Name="txtDone"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       Grid.Column="4" 
                                       HeightRequest="45" 
                                       IsReadOnly="True"
                                       HorizontalTextAlignment="Center"
                                       TextChanged="TxtDone_TextChanged"/>
                            </Frame>
                        </Grid>

                        <!-- Buttons Row -->
                        <Grid ColumnDefinitions="*,*" 
                                  ColumnSpacing="10" 
                                  Margin="0,-5,0,0">

                            <Button x:Name="btnViewItems" 
                                    Grid.Column="0" 
                                    Text="View Items" 
                                    FontAttributes="Bold" 
                                    FontSize="16" 
                                    HeightRequest="40" 
                                    BackgroundColor="Blue"
                                    CornerRadius="10"
                                    Clicked="BtnViewItems_Clicked"
                                    FontFamily="MontserratRegular"/>

                            <Button x:Name="btnAccept" 
                                    Grid.Column="1" 
                                    Text="Accept" 
                                    FontAttributes="Bold" 
                                    FontSize="16" 
                                    HeightRequest="40" 
                                    BackgroundColor="Green"
                                    CornerRadius="10"
                                    Clicked="BtnAccept_Clicked"
                                    FontFamily="MontserratRegular"/>

                            <!-- HIDDEN - Kept for future use, overlaps btnAccept -->
                            <Button x:Name="btnConso" 
                                    Grid.Column="1" 
                                    Text="Conso" 
                                    FontAttributes="Bold" 
                                    FontSize="Medium" 
                                    HeightRequest="50" 
                                    Clicked="BtnConso_Clicked"
                                    IsVisible="False"
                                    IsEnabled="False"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="10,10,10,10"
                        Margin="5,0,5,0"
                        HasShadow="True"
                        CornerRadius="10"
                        BorderColor="LightGray">
                    <VerticalStackLayout>
                        <!-- Transfer, Location, Picker, Transfer # Labels -->
                        <Label x:Name="lblTransfer" 
                               Text="Transfer:" 
                               FontSize="14"
                               Loaded="LblTransfer_Loaded"/>
                        <Label x:Name="lblLoc"
                               Text="Location:" 
                               FontSize="14"
                               Loaded="LblLoc_Loaded"/>
                        <Label x:Name="lblPicker" 
                               Text="Picker:" 
                               FontSize="14"
                               Loaded="LblPicker_Loaded"/>
                    </VerticalStackLayout>
                </Frame>

                <Grid Grid.Row="1"
                      BackgroundColor="Blue"
                      Padding="10"
                      Margin="-5,0,-5,0">
                    <Label x:Name="lblTrf" 
                        Text="Transfer #:" 
                        TextColor="White"
                        FontAttributes="Bold,Italic"
                        FontSize="14"
                        Margin="5,-8,-5,0"
                        Loaded="LblTrf_Loaded"/>
                </Grid>

                <!-- Request Button -->
                <ImageButton x:Name="pbReq"
                             Source="your_image.png"
                             HeightRequest="50"
                             WidthRequest="50"
                             BackgroundColor="Black"
                             IsVisible="False"/>

                <!-- Navigation Panel -->
                <StackLayout x:Name="pnlNavigate" 
                             IsVisible="False" 
                             Orientation="Horizontal" 
                             HorizontalOptions="Center"
                             Margin="0,10,0,0" 
                             Spacing="10">
                </StackLayout>

                <!-- Hidden Labels for data storage -->
                <Label x:Name="txtpCase" IsVisible="False"/>
                <Label x:Name="txtpDescr" IsVisible="False"/>
                <Label x:Name="txtpEach" IsVisible="False"/>
                <Label x:Name="txtpSKU" IsVisible="False"/>
                <Label x:Name="txtpSlot" IsVisible="False"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- LAYER 2: Items Panel OVERLAY (Full Screen with Horizontal & Vertical Scroll) -->
        <Grid x:Name="pnlItems"
      IsVisible="False"
      BackgroundColor="White" 
      Padding="10"
      ZIndex="500"
      RowDefinitions="Auto,*,Auto,Auto">

            <!-- COUNT LABEL at Top -->
            <Label Grid.Row="0"
           x:Name="lblCnt"
           Text="Count: 0"
           FontAttributes="Bold"
           FontSize="16"
           Margin="10,5,10,10"
           HorizontalOptions="Start"/>

            <!-- SCROLLABLE AREA (Both Horizontal and Vertical) -->
            <ScrollView Grid.Row="1" 
                Orientation="Both"
                HorizontalScrollBarVisibility="Always"
                VerticalScrollBarVisibility="Always">
                <Grid RowDefinitions="Auto,*">

                    <!-- COLUMN HEADERS (Fixed width for horizontal scroll) -->
                    <Grid Grid.Row="0"
                  ColumnDefinitions="80,200,80,80,150,80,80,80"
                  Padding="5"
                  HeightRequest="45"
                  BackgroundColor="Blue"
                  WidthRequest="830">
                        <Label Text="SKU" 
                       Grid.Column="0" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Description" 
                       Grid.Column="1" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Qty" 
                       Grid.Column="2" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Picked" 
                       Grid.Column="3" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="UPC" 
                       Grid.Column="4" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="ChkQty" 
                       Grid.Column="5" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="BUM" 
                       Grid.Column="6" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Slot" 
                       Grid.Column="7" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                    </Grid>

                    <!-- COLLECTION VIEW (Fixed width to enable horizontal scroll) -->
                    <CollectionView Grid.Row="1"
                            x:Name="lvSKU"
                            SelectionMode="Single"
                            WidthRequest="830">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,200,80,80,150,80,80,80"
                              Padding="5,15"
                              BackgroundColor="White">

                                    <!-- Separator line -->
                                    <BoxView Grid.ColumnSpan="8" 
                                     HeightRequest="1" 
                                     Color="LightGray" 
                                     VerticalOptions="End"/>

                                    <Label Text="{Binding SKU}" 
                                   Grid.Column="0" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Descr}" 
                                   Grid.Column="1" 
                                   FontSize="12" 
                                   LineBreakMode="WordWrap" 
                                   VerticalTextAlignment="Center"
                                   Padding="5,0"/>
                                    <Label Text="{Binding Qty}" 
                                   Grid.Column="2" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding PickQty}" 
                                   Grid.Column="3" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding UPC}" 
                                   Grid.Column="4" 
                                   FontSize="11" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ChkQty}" 
                                   Grid.Column="5" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center" 
                                   TextColor="{Binding ChkQtyColor}"/>
                                    <Label Text="{Binding BUM}" 
                                   Grid.Column="6" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Slot}" 
                                   Grid.Column="7" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>

            <!-- Spacer -->
            <BoxView Grid.Row="2" HeightRequest="10" Color="Transparent"/>

            <!-- Close Button at BOTTOM -->
            <Button Grid.Row="3"
            x:Name="btnCloseItems"
            Text="✕ Close Items"
            FontAttributes="Bold"
            BackgroundColor="Red"
            TextColor="White"
            HeightRequest="50"
            CornerRadius="10"
            Margin="0,5,0,10"
            Clicked="BtnCloseItems_Clicked"/>
        </Grid>

        <!-- LAYER 3: Items Panel 2 OVERLAY (Full Screen with Horizontal & Vertical Scroll) -->
        <Grid x:Name="pnlItems2"
      IsVisible="False"
      BackgroundColor="White" 
      Padding="10"
      ZIndex="500"
      RowDefinitions="Auto,*,Auto,Auto">

            <!-- COUNT LABEL at Top -->
            <Label Grid.Row="0"
           x:Name="lblCnt2"
           Text="Count: 0"
           FontAttributes="Bold"
           FontSize="16"
           Margin="10,5,10,10"
           HorizontalOptions="Start"/>

            <!-- SCROLLABLE AREA (Both Horizontal and Vertical) -->
            <ScrollView Grid.Row="1" 
                Orientation="Both"
                HorizontalScrollBarVisibility="Always"
                VerticalScrollBarVisibility="Always">
                <Grid RowDefinitions="Auto,*">

                    <!-- COLUMN HEADERS (Fixed width for horizontal scroll) -->
                    <Grid Grid.Row="0"
                  ColumnDefinitions="80,200,80,80,150,80,80,80"
                  Padding="5"
                  HeightRequest="45"
                  BackgroundColor="Blue"
                  WidthRequest="830">
                        <Label Text="SKU" 
                       Grid.Column="0" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Description" 
                       Grid.Column="1" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Qty" 
                       Grid.Column="2" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Picked" 
                       Grid.Column="3" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="UPC" 
                       Grid.Column="4" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="ChkQty" 
                       Grid.Column="5" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="BUM" 
                       Grid.Column="6" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                        <Label Text="Slot" 
                       Grid.Column="7" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center"/>
                    </Grid>

                    <!-- COLLECTION VIEW (Fixed width to enable horizontal scroll) -->
                    <CollectionView Grid.Row="1"
                            x:Name="lvSKU2"
                            SelectionMode="Single"
                            WidthRequest="830">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="80,200,80,80,150,80,80,80"
                              Padding="5,15"
                              BackgroundColor="White">

                                    <!-- Separator line -->
                                    <BoxView Grid.ColumnSpan="8" 
                                     HeightRequest="1" 
                                     Color="LightGray" 
                                     VerticalOptions="End"/>

                                    <Label Text="{Binding SKU}" 
                                   Grid.Column="0" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Descr}" 
                                   Grid.Column="1" 
                                   FontSize="12" 
                                   LineBreakMode="WordWrap" 
                                   VerticalTextAlignment="Center"
                                   Padding="5,0"/>
                                    <Label Text="{Binding Qty}" 
                                   Grid.Column="2" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding PickQty}" 
                                   Grid.Column="3" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding UPC}" 
                                   Grid.Column="4" 
                                   FontSize="11" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ChkQty}" 
                                   Grid.Column="5" 
                                   FontSize="13" 
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center" 
                                   TextColor="{Binding ChkQtyColor}"/>
                                    <Label Text="{Binding BUM}" 
                                   Grid.Column="6" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                    <Label Text="{Binding Slot}" 
                                   Grid.Column="7" 
                                   FontSize="13" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </ScrollView>

            <!-- Spacer -->
            <BoxView Grid.Row="2" HeightRequest="10" Color="Transparent"/>

            <!-- Close Button at BOTTOM -->
            <Button Grid.Row="3"
            x:Name="btnCloseItems2"
            Text="✕ Close Items"
            FontAttributes="Bold"
            BackgroundColor="Red"
            TextColor="White"
            HeightRequest="50"
            CornerRadius="10"
            Margin="0,5,0,10"
            Clicked="BtnCloseItems2_Clicked"/>
        </Grid>

        <!-- LAYER 4: Confirmation Panel OVERLAY -->
        <Frame x:Name="pnlConfirm" 
               IsVisible="False" 
               Padding="20" 
               BackgroundColor="White" 
               BorderColor="Gray"
               CornerRadius="10"
               HasShadow="True"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="280"
               HeightRequest="350"
               ZIndex="700">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="lblConfirmTitle"
                       Text="Confirm Zero Qty from a Stocker"
                       FontAttributes="Bold"
                       FontSize="25"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Loaded="LblConfirmTitle_Loaded"/>
                <Label x:Name="lblInput"
                       Text="Stocker ID:"
                       FontAttributes="Bold"
                       FontSize="16" 
                       TextColor="Black"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"
                       Loaded="LblInput_Loaded"/>
                <Entry x:Name="txtStocker"
                       Placeholder="Enter Stocker ID"
                       Keyboard="Numeric"
                       WidthRequest="150"
                       HeightRequest="50"
                       Completed="TxtStocker_Completed"
                       TextChanged="TxtStocker_TextChanged"
                       StyleId="txtStocker"
                       HorizontalTextAlignment="Center"
                       Margin="0,5,0,10"/>
                <Button x:Name="btnConfirm"
                        Text="Confirm"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        BackgroundColor="Blue"
                        WidthRequest="150"
                        HeightRequest="50"
                        Clicked="BtnConfirm_Clicked" />
                <Button x:Name="btnCancel"
                        Text="Cancel"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        BackgroundColor="Red"
                        TextColor="White"
                        WidthRequest="150"
                        HeightRequest="50"
                        Clicked="BtnCancel_Clicked"/>
            </VerticalStackLayout>
        </Frame>

        <!-- LAYER 5: Finished Button (Topmost) -->
        <Button x:Name="btnFinished"
                Text="✓ Finish Checking?"
                IsVisible="False"
                BackgroundColor="#28a745"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="55"
                WidthRequest="200"
                CornerRadius="18"
                Clicked="BtnFinished_Clicked"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,110,0,0"
                ZIndex="1000"
                Opacity="0.95"/>
    </Grid>
</ContentPage>