<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDTPickingSystem.Views.SetRefPage"
             Title="Set Picking Reference"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <!-- App Logo -->
        <Image Source="pblogo.png"
                   HorizontalOptions="Center"
                   HeightRequest="100"
                   WidthRequest="320"
                   Aspect="AspectFit"
                   Margin="0,-5,0,0"/>

        <!-- Page Title -->
        <Label Text="Set Picking Reference"
                   FontSize="24"
                   TextColor="Blue"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   LineBreakMode="NoWrap"
                   Margin="0,0,0,0"/>

        <!-- Input Reference Label for OnParentSet -->
        <Label x:Name="lblInputPickRef"
                   Text="Input Picking Reference #"
                   FontSize="14"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,0"/>

        <!-- Reference Number Entry -->
        <Frame Padding="0"
               BackgroundColor="White"
               BorderColor="Gray"
               CornerRadius="5"
               HasShadow="True"
               HorizontalOptions="Center"
               WidthRequest="220"
               Margin="0,-5,0,0">
            <Entry x:Name="txtRefNo"
                   Placeholder="Enter Reference Number"
                   FontSize="16"
                   BackgroundColor="Transparent"
                   TextColor="Black"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="Center"
                   TextChanged="TxtRefNo_TextChanged"
                   Completed="TxtRefNo_Completed"
                   HeightRequest="45" />
        </Frame>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="actLoading"
                   IsRunning="False"
                   IsVisible="False"
                   Color="Blue"
                   HeightRequest="30"
                   HorizontalOptions="Center"/>

        <!-- Display Reference -->
        <Label x:Name="lblRefDisplay"
                   Text="(Reference #)"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,0"/>

        <!-- Apply / Save Button -->
        <Button x:Name="btnApply"
                    Text="Set Reference"
                    Clicked="btnApply_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    Padding="0"
                    WidthRequest="220"
                    HeightRequest="50"
                    FontSize="16"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    FontFamily="MontserratRegular"/>

        <!-- Cancel / Back Button -->
        <Button x:Name="btnBack"
                    Text="Back to Menu"
                    Clicked="btnBack_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Padding="0"
                    WidthRequest="220"
                    HeightRequest="50"
                    FontSize="16"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    FontFamily="MontserratRegular"
                    Margin="0,0,0,0"/>

    </VerticalStackLayout>
</ContentPage>
