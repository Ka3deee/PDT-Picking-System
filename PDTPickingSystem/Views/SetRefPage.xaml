<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDTPickingSystem.Views.SetRefPage"
             Title="Set Picking Reference"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="3,5" Radius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="3,5" Radius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Frame Style="{StaticResource CardFrame}" 
               Margin="10,0,10,0"
               Padding="0"
               BackgroundColor="Blue"
               CornerRadius="10"
               HasShadow="True"
               HeightRequest="100">
            <!-- App Logo -->
            <Image Source="pblogo.png"
                   HorizontalOptions="Center"
                   HeightRequest="130"
                   WidthRequest="320"
                   Aspect="AspectFit"
                   Margin="0,0,0,0"/>
        </Frame>

        <!-- Page Title -->
        <Label Text="Set Picking Reference"
                   FontSize="24"
                   TextColor="Blue"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   LineBreakMode="NoWrap"
                   Margin="0,0,0,0"/>

        <!-- Input Reference -->
        <Label x:Name="lblInputPickRef"
                   Text="Input Picking Reference #"
                   FontSize="14"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,0"/>

        <!-- Reference Number Entry -->
        <Frame Style="{StaticResource CardFrame}"
               Padding="0"
               BackgroundColor="White"
               BorderColor="Gray"
               CornerRadius="5"
               HasShadow="True"
               HorizontalOptions="Center"
               WidthRequest="220"
               HeightRequest="60"
               Margin="0,-5,0,0">
            <Entry x:Name="txtRefNo"
                   Placeholder="Enter Reference Number"
                   FontSize="16"
                   BackgroundColor="Transparent"
                   TextColor="Black"
                   Keyboard="Numeric"
                   HorizontalTextAlignment="Center"
                   TextChanged="TxtRefNo_TextChanged"
                   Completed="TxtRefNo_Completed"
                   HeightRequest="45" />
        </Frame>

        <!-- Loading Indicator -->
        <ActivityIndicator x:Name="actLoading"
                   IsRunning="False"
                   IsVisible="False"
                   Color="Blue"
                   HeightRequest="30"
                   HorizontalOptions="Center"/>

        <!-- Display Reference -->
        <Label x:Name="lblRefDisplay"
                   Text="(Reference #)"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,0"/>

        <!-- Apply / Save Button -->
        <Button x:Name="btnApply"
                    Text="Set Reference"
                    Clicked="btnApply_Clicked"
                    Style="{StaticResource PrimaryButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    Padding="0"
                    WidthRequest="220"
                    HeightRequest="60"
                    FontSize="16"
                    CornerRadius="18"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    FontFamily="MontserratRegular"/>

        <!-- Cancel / Back Button -->
        <Button x:Name="btnBack"
                    Text="Back to Menu"
                    Clicked="btnBack_Clicked"
                    Style="{StaticResource PrimaryButton}"
                    BackgroundColor="Red"
                    TextColor="White"
                    Padding="0"
                    WidthRequest="220"
                    HeightRequest="60"
                    FontSize="16"
                    CornerRadius="18"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    FontFamily="MontserratRegular"
                    Margin="0,0,0,0"/>

    </VerticalStackLayout>
</ContentPage>
