<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDTPickingSystem.Views.MainMenuPage"
             Title="LCC Picking System"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- 🔹 HEADER -->
        <Grid Row="0"
              ColumnDefinitions="Auto,10,*"
              BackgroundColor="Blue"
              HeightRequest="50"
              VerticalOptions="Start"
              Padding="15,0,0,0">

            <!-- Logo -->
            <Image Source="lcclogo2.png"
                   HeightRequest="40"
                   WidthRequest="40"
                   VerticalOptions="Center"/>

            <!-- Title -->
            <Label Grid.Column="2"
                   Text="PDT Picking System"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="0,0,0,0"/>
        </Grid>


    <VerticalStackLayout Padding="0" Spacing="5">

        <!-- App Logo with Tap Gesture for Version Info -->
        <Image x:Name="imgLogo"
               Source="pblogo.png"
               HorizontalOptions="Fill"
               VerticalOptions="Start"
               HeightRequest="100"
               WidthRequest="320"
               Aspect="AspectFit"
               Margin="0,60,0,0">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="ImgLogo_Tapped"/>
            </Image.GestureRecognizers>
        </Image>

        <!-- First row -->
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
            <Button Text="Start Picking"
                    Clicked="BtnOpt1_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="10"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>

            <Button Text="Start Checking"
                    Clicked="BtnOpt2_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>
        </HorizontalStackLayout>

        <!-- Second row -->
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
            <Button Text="Set User ID"
                    Clicked="BtnOpt3_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>

            <Button Text="Confirm Check"
                    Clicked="BtnOpt4_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>
        </HorizontalStackLayout>

        <!-- Third row -->
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button Text="Server Settings"
                    Clicked="BtnOpt5_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="285"
                    HeightRequest="60"
                    FontSize="18"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>
        </HorizontalStackLayout>

        <!-- Fourth row -->
        <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
            <Button Text="Set Pick Ref"
                    Clicked="BtnOpt6_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>

            <Button Text="Exit"
                    Clicked="BtnOpt7_Clicked"
                    Style="{StaticResource AppButton}"
                    BackgroundColor="#D83B01"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="60"
                    FontSize="16"
                    Padding="5"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="MontserratRegular"/>
        </HorizontalStackLayout>

        <!-- User Info -->
        <Label x:Name="lblUser"
               Text="User: (None)"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="Black"
               HorizontalOptions="Center"/>

        <!-- Status -->
        <Grid Grid.Row="1"
              Padding="0"
              Margin="0,0,0,0">
            <Label x:Name="lblStatus"
               Text=""
               FontSize="14"
               TextColor="Black"
               HorizontalOptions="Center"
               Margin="0,-5,0,5"/>
        </Grid>

        <!-- App Version -->
        <Grid Grid.Row="1"
              BackgroundColor="Blue"
              Padding="10"
              Margin="-30,-5,-30,0">
            <Label Text="{Binding VersionText}"
                   FontSize="12"
                   TextColor="White"
                   FontAttributes="None"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,-5,0,5"/>
        </Grid>
    </VerticalStackLayout>
        </Grid>
</ContentPage>