<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PDTPickingSystem.Views.ConfirmCheckPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Title="Confirm Check">

    <!-- ✅ ROOT GRID with overlapping panels -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================
             PANEL 1: MAIN INPUT (pnlMain)
             ======================================== -->
        <Frame Padding="10"
               Margin="10,10,10,10"
               HasShadow="True"
               BorderColor="LightGray"
               CornerRadius="10">
            <VerticalStackLayout x:Name="pnlMain"
                                 Padding="5"
                                 Spacing="5"
                                 IsVisible="True">

                <!-- Barcode -->
                <Label Text="Barcode:"
                       FontAttributes="Bold"
                       FontSize="16"/>
                <Frame Grid.Column="1"
                       Padding="5"
                       CornerRadius="5"
                       HasShadow="True"
                       BorderColor="Gray"
                       VerticalOptions="Center"
                       HorizontalOptions="FillAndExpand"
                       Margin="0,0,0,5">
                    <Entry x:Name="txtBarcode"
                           Placeholder="Scan or enter barcode"
                           FontSize="16"
                           HeightRequest="45"
                           HorizontalTextAlignment="Center"/>
                </Frame>

                <!-- Description (Label, not Entry) -->
                <Frame Grid.Column="1"
                       Padding="0"
                       CornerRadius="5"
                       HasShadow="True"
                       BorderColor="Gray"
                       VerticalOptions="Center"
                       HorizontalOptions="FillAndExpand"
                       Margin="0,0,0,5">
                    <Label x:Name="txtDesc"
                           Text="Description"
                           FontSize="16"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,5"/>
                </Frame>

                <!-- Scanned Icon -->
                <Grid ColumnDefinitions="50,10,Auto,*"
                      Margin="0,0,0,10"
                      VerticalOptions="Center">
                    <!-- ➤ Scan Image -->
                    <Image x:Name="pbScanned"
                           Grid.Column="0"
                           Source="scanned_icon2.png"
                           HeightRequest="40"
                           WidthRequest="40"
                           HorizontalOptions="Start"
                           IsVisible="False"/>
                    <!-- ➤ SKU Label -->
                    <Label Grid.Column="2"
                           Text="SKU:"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="16"
                           Margin="0,0,10,0"/>
                    <!-- ➤ SKU Entry with Frame -->
                    <Frame Grid.Column="3"
                           Padding="-5"
                           HeightRequest="40"
                           CornerRadius="5"
                           HasShadow="True"
                           BorderColor="Gray"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           Margin="0,0,0,0">
                        <Entry x:Name="txtSKU"
                               IsReadOnly="True"
                               BackgroundColor="White"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"/>
                    </Frame>
                </Grid>


                <!-- CASE / EACH -->
                <Grid ColumnDefinitions="Auto,*,20,Auto,*" Margin="0,5">
                    <Label Text="Case:" 
                           Grid.Column="0" 
                           VerticalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Frame Grid.Column="1"
                           Padding="0"
                           HeightRequest="40"
                           CornerRadius="5"
                           HasShadow="True"
                           BorderColor="Gray"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           Margin="5,0,0,0">
                        <Entry x:Name="txtCase" 
                               Grid.Column="1"
                               Text=""
                               FontSize="16"
                               Keyboard="Numeric"
                               HeightRequest="45"
                               HorizontalTextAlignment="Center"/>
                    </Frame>

                    <Label Text="Each:" 
                           Grid.Column="3" 
                           VerticalOptions="Center"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Frame Grid.Column="4"
                           Padding="0"
                           HeightRequest="40"
                           CornerRadius="5"
                           HasShadow="True"
                           BorderColor="Gray"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           Margin="5,0,0,0">
                        <Entry x:Name="txtEach" 
                               Grid.Column="4"
                               Text=""
                               FontSize="16"
                               Keyboard="Numeric"
                               HeightRequest="45"
                               HorizontalTextAlignment="Center"/>
                    </Frame>
                </Grid>

                <!-- BUM -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                    <Label Text="BUM:" 
                           Grid.Column="0" 
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="16"/>
                    <Frame Grid.Column="1"
                           Padding="0"
                           HeightRequest="40"
                           CornerRadius="5"
                           HasShadow="True"
                           BorderColor="Gray"
                           VerticalOptions="Center"
                           HorizontalOptions="FillAndExpand"
                           Margin="5,0,0,0">
                        <Entry x:Name="txtBum" 
                               Grid.Column="2"
                               Text=""
                               FontSize="16"
                               IsReadOnly="True"
                               HeightRequest="45"
                               BackgroundColor="White"
                               HorizontalTextAlignment="Center"/>
                    </Frame>
                </Grid>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,*" 
                      ColumnSpacing="10" 
                      Margin="0,20,0,0">
                    <Button x:Name="btnDetails"
                            Padding="0"
                            Grid.Column="0"
                            Text="View Details"
                            FontSize="16"
                            CornerRadius="10"
                            BackgroundColor="Blue"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Clicked="BtnDetails_Clicked"
                            FontFamily="MontserratRegular"/>

                    <Button x:Name="btnAccept"
                            Grid.Column="1"
                            Text="Accept"
                            FontSize="16"
                            CornerRadius="10"
                            BackgroundColor="Green"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Clicked="BtnAccept_Clicked"
                            FontFamily="MontserratRegular"/>
                </Grid>

            </VerticalStackLayout>
        </Frame>

        <!-- ========================================
         PANEL 2: DETAILS VIEW (pnlDetails)
         ======================================== -->
        <Frame x:Name="pnlDetails"
       Grid.Row="0"
       IsVisible="False"
       Padding="5"
       Margin="10"
       BackgroundColor="White"
       BorderColor="Gray"
       CornerRadius="10"
       HasShadow="True">

            <VerticalStackLayout Padding="5" Spacing="5" BackgroundColor="White">

                <Label Text="SKU Details"
               FontSize="25"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,5,0,0"/>

                <!-- Horizontal ScrollView wrapping both headers and CollectionView -->
                <ScrollView Orientation="Horizontal">

                    <VerticalStackLayout Spacing="0">

                        <!-- Column Headers -->
                        <Grid ColumnDefinitions="60,70,130,40,60,60,60,60,60,60,60,60"
                      RowDefinitions="Auto"
                      Margin="0,0,0,5"
                      BackgroundColor="#EEE">
                            <Label Text="Slot" Grid.Column="0" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="SKU" Grid.Column="1" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="Descr" Grid.Column="2" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="Qty" Grid.Column="3" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="Picked" Grid.Column="4" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="UPC" Grid.Column="5" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="ChkQty" Grid.Column="6" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="IsSorted" Grid.Column="7" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="IsCSorted" Grid.Column="8" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="PickBy" Grid.Column="9" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="CheckBy" Grid.Column="10" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                            <Label Text="IsConfirmed" Grid.Column="11" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                        </Grid>

                        <!-- SKU CollectionView -->
                        <CollectionView x:Name="lvSKU"
                                SelectionMode="Single"
                                SelectionChanged="lvSKU_SelectionChanged"
                                HeightRequest="280">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="8"
                                   Margin="0,2"
                                   BorderColor="Gray"
                                   CornerRadius="5"
                                   HasShadow="False">
                                        <Grid ColumnDefinitions="50,70,130,40,60,60,60,60,60,60,60,60"
                                      RowDefinitions="Auto"
                                      RowSpacing="5">
                                            <Label Text="{Binding Slot}" Grid.Column="0" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding SKU}" Grid.Column="1" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Descr}" Grid.Column="2" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Qty}" Grid.Column="3" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Picked}" Grid.Column="4" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding UPC}" Grid.Column="5" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding ChkQty}" Grid.Column="6" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding IsSorted}" Grid.Column="7" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding IsCsorted}" Grid.Column="8" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding PickBy}" Grid.Column="9" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding CheckBy}" Grid.Column="10" FontSize="12" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding IsConfirmed}" Grid.Column="11" FontSize="12" HorizontalTextAlignment="Center"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Back Button -->
                <Button x:Name="Button1"
                Text="Back"
                BackgroundColor="Blue"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                WidthRequest="150"
                HeightRequest="40"
                CornerRadius="10"
                Clicked="Button1_Click"
                FontFamily="MontserratRegular"
                Margin="0,0,0,0"/>
            </VerticalStackLayout>
        </Frame>


        <!-- ========================================
             PANEL 3: SELECT TRANSFER (pnlSelectTrf)
             ======================================== -->
        <VerticalStackLayout x:Name="pnlSelectTrf"
                             Grid.Row="0"
                             Padding="10"
                             Spacing="10"
                             BackgroundColor="White"
                             IsVisible="False">

            <Label Text="Select Transfer"
                   FontSize="25"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

            <Label Text="Multiple transfers found. Please select one:"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <!-- Transfer CollectionView -->
            <CollectionView x:Name="lvSKU2"
                            SelectionMode="Single"
                            SelectionChanged="lvSKU2_SelectionChanged"
                            HeightRequest="450">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15"
                               Margin="0,5"
                               BorderColor="DodgerBlue"
                               CornerRadius="8"
                               HasShadow="True">
                            <StackLayout>
                                <Label Text="Transfer Number"
                                       FontSize="10"
                                       TextColor="Gray"/>
                                <Label Text="{Binding TransferNo}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="Black"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Select Button -->
            <Button x:Name="btnSelectTransfer"
                    Text="Select Transfer"
                    BackgroundColor="SteelBlue"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="45"
                    Clicked="Button2_Clicked"/>

        </VerticalStackLayout>

        <!-- ========================================
             USER LABEL (Bottom)
             ======================================== -->
        <Grid Grid.Row="1"
              BackgroundColor="Blue"
              Padding="5"
              Margin="0,0,0,0"
              HeightRequest="35">
            <Label x:Name="lblUser"
                   Grid.Row="1"
                   Text="User:"
                   TextColor="White"
                   Padding="10,0,0,0"
                   Margin="0,3,0,0"
                   VerticalOptions="Center"
                   FontAttributes="Bold,Italic"
                   FontSize="14"/>
        </Grid>
    </Grid>
</ContentPage>