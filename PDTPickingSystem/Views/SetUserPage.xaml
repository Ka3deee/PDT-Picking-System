<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDTPickingSystem.Views.SetUserPage"
             Title="Set User ID"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

            <!-- App Logo -->
            <Image Source="pblogo.png"
                   HorizontalOptions="Center"
                   HeightRequest="100"
                   WidthRequest="320"
                   Aspect="AspectFit"
                   Margin="0,-5,0,0"/>

            <!-- Page Title -->
            <Label Text="Set User ID"
                   FontSize="24"
                   TextColor="Blue"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Margin="0,0,0,0"/>

            <Label x:Name="lblInputUserID"
                   Text="Input User ID:"
                   FontSize="14"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,0,0,0"/>

            <!-- User ID Entry -->
        <Frame Padding="0"
               BackgroundColor="White"
               BorderColor="Gray"
               CornerRadius="5"
               HasShadow="True"
               HorizontalOptions="Center"
               WidthRequest="220"
               Margin="0,-5,0,0">
            <Entry x:Name="txtEENo"
                   Placeholder="Enter User ID"
                   FontSize="16"
                   BackgroundColor="Transparent"
                   TextColor="Black"
                   Keyboard="Numeric"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   WidthRequest="220"
                   HeightRequest="45"/>
        </Frame>

        <!-- Loading Indicator -->
            <ActivityIndicator x:Name="actLoading"
                   IsRunning="False"
                   IsVisible="False"
                   Color="Blue"
                   HeightRequest="30"
                   HorizontalOptions="Center"/>

            <!-- Display User Name -->
            <Label x:Name="lblName"
                   Text="(Name)"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,0"/>

            <!-- Confirm / Apply Button -->
            <Button x:Name="btnApply"
                   Text="Confirm and Apply"
                   Style="{StaticResource AppButton}"
                   BackgroundColor="Blue"
                   TextColor="White"
                   WidthRequest="220"
                   HeightRequest="50"
                   FontSize="16"
                   CornerRadius="10"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   FontFamily="MontserratRegular"/>

            <!-- Back Button -->
            <Button x:Name="btnBack"
                   Text="Back to Menu"
                   Style="{StaticResource AppButton}"
                   BackgroundColor="Red"
                   TextColor="White"
                   WidthRequest="220"
                   HeightRequest="50"
                   FontSize="16"
                   CornerRadius="10"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   FontFamily="MontserratRegular"
                   Margin="0,0,0,0"/>

            <!-- User Info -->
            <Label x:Name="lblUser"
                   Text="User: (None)"
                   FontAttributes="None"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-5,0,0"/>

        </VerticalStackLayout>
</ContentPage>
