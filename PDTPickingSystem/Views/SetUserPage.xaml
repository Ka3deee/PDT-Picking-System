<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PDTPickingSystem.Views.SetUserPage"
             Title="Set User ID"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="3,5" Radius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="3,5" Radius="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

        <Frame Style="{StaticResource CardFrame}" 
               Margin="30,10,30,0"
               Padding="0"
               BackgroundColor="Blue"
               CornerRadius="10"
               HasShadow="True"
               HeightRequest="100">
            <!-- App Logo -->
            <Image Source="pblogo.png"
                   HorizontalOptions="Center"
                   HeightRequest="130"
                   WidthRequest="320"
                   Aspect="AspectFit"
                   Margin="0,0,0,0"/>
        </Frame>

        <!-- Page Title -->
            <Label Text="Set User ID"
                   FontSize="24"
                   TextColor="Blue"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   Margin="0,0,0,0"/>

            <Label x:Name="lblInputUserID"
                   Text="Input User ID:"
                   FontSize="14"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,0"/>

            <!-- User ID Entry -->
        <Frame Style="{StaticResource CardFrame}" 
               Padding="0"
               BackgroundColor="White"
               BorderColor="Gray"
               CornerRadius="5"
               HasShadow="True"
               HorizontalOptions="Center"
               WidthRequest="220"
               HeightRequest="60"
               Margin="0,-5,0,0">
            <Entry x:Name="txtEENo"
                   Placeholder="Enter User ID"
                   FontSize="16"
                   BackgroundColor="Transparent"
                   TextColor="Black"
                   Keyboard="Numeric"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   WidthRequest="220"
                   HeightRequest="45"/>
        </Frame>

        <!-- Loading Indicator -->
            <ActivityIndicator x:Name="actLoading"
                   IsRunning="False"
                   IsVisible="False"
                   Color="Blue"
                   HeightRequest="30"
                   HorizontalOptions="Center"/>

            <!-- Display User Name -->
            <Label x:Name="lblName"
                   Text="(Name)"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,0"/>

            <!-- Confirm / Apply Button -->
            <Button x:Name="btnApply"
                   Text="Confirm and Apply"
                   Style="{StaticResource PrimaryButton}"
                   BackgroundColor="Blue"
                   TextColor="White"
                   WidthRequest="220"
                   HeightRequest="60"
                   FontSize="16"
                   CornerRadius="10"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   FontFamily="MontserratRegular"
                   Margin="0,-5,0,0"/>

            <!-- Back Button -->
            <Button x:Name="btnBack"
                   Text="Back to Menu"
                   Style="{StaticResource PrimaryButton}"
                   BackgroundColor="Red"
                   TextColor="White"
                   WidthRequest="220"
                   HeightRequest="60"
                   FontSize="16"
                   CornerRadius="10"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   FontFamily="MontserratRegular"
                   Margin="0,0,0,0"/>

            <!-- User Info -->
            <Label x:Name="lblUser"
                   Text="User: (None)"
                   FontAttributes="None"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   Margin="0,-5,0,0"/>

        </VerticalStackLayout>
</ContentPage>
